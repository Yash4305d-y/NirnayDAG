{
  "name": "nirnay-dag",
  "version": "1.0.0",
  "description": "Computational Architecture Decision Graph Engine, Linter & MCP Server",
  "author": "Yash Vinay Kalyani",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Yash4305d-y/NirnayDAG.git"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js",
      "require": "./dist/mcp.cjs"
    }
  },
  "bin": {
    "nirnay-dag": "./dist/cli.js",
    "ndag": "./dist/cli.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "build": "vite build && tsup",
    "check": "npm run typecheck && npm run lint && npm run build && npm run test",
    "build:cli": "tsup",
    "build:web": "vite build",
    "dev": "vite",
    "dev:cli": "tsx watch src/cli/index.ts",
    "demo": "tsx scripts/demo.ts",
    "corpus": "tsx scripts/corpus/run.ts",
    "mcp:inspect": "npx @modelcontextprotocol/inspector node dist/mcp.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xyflow/react": "^12.11.3",
    "chalk": "^6.0.0",
    "chokidar": "^5.0.0",
    "cli-table3": "^0.6.5",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "dagre": "^0.8.5",
    "express": "^4.21.2",
    "fast-glob": "^3.3.3",
    "framer-motion": "^13.1.0",
    "fs-extra": "^11.4.0",
    "gray-matter": "^4.0.3",
    "html-to-image": "^1.11.13",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^5.3.0",
    "lucide-react": "^1.33.0",
    "ora": "^9.4.1",
    "picomatch": "^4.0.7",
    "prompts": "^2.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reactflow": "^11.11.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/dagre": "^0.7.54",
    "@types/express": "^5.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "@types/picomatch": "^4.0.3",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "fast-check": "^4.11.0",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "prettier": "^3.5.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
